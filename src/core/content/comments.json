[
  { "id": "hot_01", "text": "Tohle je přesně důvod, proč už nikomu nevěřím.", "category": "hot-take", "baseQuality": 0.52, "variance": 0.45, "brainRotAffinity": 0.40 },
  { "id": "hot_02", "text": "Nikdo nemá odvahu to říct nahlas, tak to řeknu já.", "category": "hot-take", "baseQuality": 0.55, "variance": 0.48, "brainRotAffinity": 0.45 },
  { "id": "hot_03", "text": "Normální člověk tohle prokoukne za pět vteřin.", "category": "hot-take", "baseQuality": 0.50, "variance": 0.44, "brainRotAffinity": 0.38 },
  { "id": "hot_04", "text": "Říkal jsem to už před deseti lety, ale nikdo neposlouchal.", "category": "hot-take", "baseQuality": 0.48, "variance": 0.42, "brainRotAffinity": 0.35 },
  { "id": "hot_05", "text": "Za všechno si můžeme sami a nikdo to nechce slyšet.", "category": "hot-take", "baseQuality": 0.53, "variance": 0.46, "brainRotAffinity": 0.42 },

  { "id": "whole_01", "text": "Tohle mi udělalo celý den, děkuju že existuješ! ❤️", "category": "wholesome", "baseQuality": 0.68, "variance": 0.20, "brainRotAffinity": 0.02 },
  { "id": "whole_02", "text": "Posílám sílu všem, kdo to dnes mají těžké. 🙏", "category": "wholesome", "baseQuality": 0.65, "variance": 0.22, "brainRotAffinity": 0.03 },
  { "id": "whole_03", "text": "Krásné! Sdílím dál, ať to vidí celý svět.", "category": "wholesome", "baseQuality": 0.63, "variance": 0.24, "brainRotAffinity": 0.04 },
  { "id": "whole_04", "text": "Lidé jako ty dávají internetu smysl.", "category": "wholesome", "baseQuality": 0.66, "variance": 0.21, "brainRotAffinity": 0.02 },
  { "id": "whole_05", "text": "Nezapomeňte se dnes na sebe usmát, zasloužíte si to.", "category": "wholesome", "baseQuality": 0.62, "variance": 0.23, "brainRotAffinity": 0.03 },

  { "id": "copy_01", "text": "Kopíruj a vlož, jinak ti zítra spadne Wi-Fi. Funguje, vyzkoušeno!", "category": "copypasta", "baseQuality": 0.46, "variance": 0.40, "brainRotAffinity": 0.20 },
  { "id": "copy_02", "text": "Sdílej do 3 skupin a tvůj telefon se nabije na 200 %.", "category": "copypasta", "baseQuality": 0.44, "variance": 0.42, "brainRotAffinity": 0.22 },
  { "id": "copy_03", "text": "Devět z deseti lidí tohle nedočte do konce. Buď ten desátý.", "category": "copypasta", "baseQuality": 0.50, "variance": 0.38, "brainRotAffinity": 0.18 },
  { "id": "copy_04", "text": "Pošli toto deseti přátelům a algoritmus tě odmění.", "category": "copypasta", "baseQuality": 0.45, "variance": 0.41, "brainRotAffinity": 0.20 },
  { "id": "copy_05", "text": "👁👄👁 ... a teď to máš taky v hlavě.", "category": "copypasta", "baseQuality": 0.48, "variance": 0.43, "brainRotAffinity": 0.24 },

  { "id": "troll_01", "text": "Ratio + nikdo se neptal + máš špatný názor.", "category": "troll", "baseQuality": 0.40, "variance": 0.52, "brainRotAffinity": 0.60 },
  { "id": "troll_02", "text": "Zdroj: vymyslel jsem si to, ale stejně mám pravdu.", "category": "troll", "baseQuality": 0.42, "variance": 0.50, "brainRotAffinity": 0.58 },
  { "id": "troll_03", "text": "Komentuji jen proto, abych ti zkazil náladu. Funguje?", "category": "troll", "baseQuality": 0.38, "variance": 0.54, "brainRotAffinity": 0.62 },
  { "id": "troll_04", "text": "Skvělý příspěvek pro lidi, co neumí číst.", "category": "troll", "baseQuality": 0.41, "variance": 0.51, "brainRotAffinity": 0.59 },
  { "id": "troll_05", "text": "First! (a teď můžete začít zuřit)", "category": "troll", "baseQuality": 0.43, "variance": 0.49, "brainRotAffinity": 0.55 },

  { "id": "normie_01", "text": "Haha přesně tak 😂", "category": "normie", "baseQuality": 0.50, "variance": 0.26, "brainRotAffinity": 0.05 },
  { "id": "normie_02", "text": "To je hustý, kde se to dá koupit?", "category": "normie", "baseQuality": 0.49, "variance": 0.27, "brainRotAffinity": 0.05 },
  { "id": "normie_03", "text": "Souhlasím 👍", "category": "normie", "baseQuality": 0.47, "variance": 0.28, "brainRotAffinity": 0.06 },
  { "id": "normie_04", "text": "Tak tohle jsem potřeboval vidět dneska ráno.", "category": "normie", "baseQuality": 0.51, "variance": 0.25, "brainRotAffinity": 0.05 },
